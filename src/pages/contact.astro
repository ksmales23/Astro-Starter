---
import Layout from '~/layouts/Layout.astro';
import { CONTACT } from '~/config';

// Formspree-backed contact form with Alpine progressive enhancement:
// - No JS: plain POST to Formspree (their hosted "thanks" page).
// - With JS: fetch() submit, inline success/error states, no page reload.
// - Spam: honeypot field (`_gotcha` — Formspree drops submissions that fill it).
// Set CONTACT.formspreeEndpoint in src/config.ts to enable.
const endpoint = CONTACT.formspreeEndpoint;
const configured = Boolean(endpoint) && !endpoint.includes('YOUR_FORM_ID');
---

<Layout metadata={{ title: 'Contact us', description: 'Get in touch.' }}>
  <div class="mx-auto w-full max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900">Contact us</h1>
    <p class="mt-4 text-gray-700">Send us a message and we'll get back to you.</p>

    <form
      x-data="contactForm()"
      @submit.prevent="submit($event)"
      action={endpoint}
      method="POST"
      class="mt-8 max-w-xl space-y-5"
    >
      <div>
        <label for="name" class="block text-sm font-medium text-gray-900">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-gray-900 focus:outline-none"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-900">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-gray-900 focus:outline-none"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-900">Comments</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-gray-900 focus:outline-none"
        ></textarea>
      </div>

      <!-- Honeypot: humans never see or fill this; bots do. -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <button
        type="submit"
        :disabled="status === 'sending'"
        class="rounded-md bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-700 disabled:opacity-50"
        x-text="status === 'sending' ? 'Sending…' : 'Send message'"
      >
        Send message
      </button>

      <p x-show="status === 'success'" x-cloak class="text-sm font-medium text-green-700" aria-live="polite">
        Thanks — your message has been sent.
      </p>
      <p x-show="status === 'error'" x-cloak class="text-sm font-medium text-red-700" aria-live="polite">
        Something went wrong sending your message. Please try again, or email us directly.
      </p>
      <p x-show="status === 'unconfigured'" x-cloak class="text-sm font-medium text-amber-700" aria-live="polite">
        This form isn't connected yet — set CONTACT.formspreeEndpoint in src/config.ts.
      </p>
    </form>
  </div>
</Layout>

<script is:inline define:vars={{ configured }}>
  window.contactForm = function contactForm() {
    return {
      status: 'idle',
      async submit(e) {
        if (!configured) {
          this.status = 'unconfigured';
          return;
        }
        this.status = 'sending';
        try {
          const res = await fetch(e.target.action, {
            method: 'POST',
            body: new FormData(e.target),
            headers: { Accept: 'application/json' },
          });
          if (res.ok) {
            this.status = 'success';
            e.target.reset();
            // Analytics convention: snake_case {object}_{action} events
            // (see src/utils/analytics.ts). Processed only if GTM + consent.
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: 'contact_form_submit' });
          } else {
            this.status = 'error';
          }
        } catch (err) {
          this.status = 'error';
        }
      },
    };
  };
</script>

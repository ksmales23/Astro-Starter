---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import Layout from '~/layouts/Layout.astro';
import { getStaticPathsBlogTag, blogTagRobots } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogTag({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, tag } = Astro.props as Props;
const posts = page.data;

const metadata = {
  title: `Tag: ${tag.title}`,
  robots: { index: blogTagRobots?.index, follow: blogTagRobots?.follow },
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-4xl font-bold">Tag: {tag.title}</h1>
    <ul class="mt-8 space-y-6">
      {
        posts.map((post) => (
          <li>
            <a class="text-2xl font-semibold underline" href={getPermalink(post.permalink, 'post')}>
              {post.title}
            </a>
            <p class="text-sm text-gray-500">{getFormattedDate(post.publishDate)}</p>
          </li>
        ))
      }
    </ul>
    <nav class="mt-10 flex justify-between">
      {
        page.url.prev ? (
          <a class="underline" href={page.url.prev}>
            ← Newer
          </a>
        ) : (
          <span />
        )
      }
      {
        page.url.next ? (
          <a class="underline" href={page.url.next}>
            Older →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </section>
</Layout>

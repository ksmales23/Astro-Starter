---
import Logo from '~/components/Logo.astro';
import { headerData } from '~/navigation';
import { getHomePermalink, trimSlash } from '~/utils/permalinks';

// Active-link detection: compare the current path with each link, ignoring
// trailing slashes. (Astro gives us the request URL at build time per page.)
const currentPath = `/${trimSlash(Astro.url.pathname)}`;
const isActive = (href: string) => {
  const link = `/${trimSlash(href)}`;
  return link === currentPath || (link !== '/' && currentPath.startsWith(`${link}/`));
};

const { links, cta } = headerData;
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4">
    <!-- Logo (left) -->
    <a href={getHomePermalink()} class="shrink-0" aria-label="Home">
      <Logo />
    </a>

    <!-- Desktop nav (right) + CTA (far right) -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive(link.href) ? 'text-gray-900' : 'text-gray-600 hover:text-gray-900',
            ]}
          >
            {link.text}
          </a>
        ))
      }
      <a
        href={cta.href}
        class="ml-3 rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-700"
      >
        {cta.text}
      </a>
    </nav>

    <!-- Mobile menu button + panel (Alpine) -->
    <div class="md:hidden" x-data="{ open: false }" @keydown.escape.window="open = false">
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 hover:bg-gray-100"
        aria-controls="mobile-menu"
        :aria-expanded="open"
        @click="open = !open"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Hamburger / close icons swap with Alpine -->
        <svg
          x-show="!open"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          x-show="open"
          x-cloak
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>

      <div
        id="mobile-menu"
        x-show="open"
        x-cloak
        x-transition.origin.top
        @click.outside="open = false"
        class="absolute inset-x-0 top-16 border-b border-gray-200 bg-white p-4 shadow-lg"
      >
        <nav class="flex flex-col gap-1" aria-label="Main (mobile)">
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-2 text-base font-medium',
                  isActive(link.href) ? 'bg-gray-100 text-gray-900' : 'text-gray-700 hover:bg-gray-50',
                ]}
              >
                {link.text}
              </a>
            ))
          }
          <a href={cta.href} class="mt-2 rounded-md bg-gray-900 px-4 py-2 text-center text-base font-medium text-white">
            {cta.text}
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>

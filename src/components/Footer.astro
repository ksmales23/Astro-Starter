---
import Logo from '~/components/Logo.astro';
import { SITE } from '~/config';
import { footerData } from '~/navigation';
import { getHomePermalink } from '~/utils/permalinks';

const { links, legalLinks, tagline } = footerData;
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-xs">
        <a href={getHomePermalink()} aria-label="Home">
          <Logo />
        </a>
        <p class="mt-3 text-sm text-gray-600">{tagline}</p>
      </div>

      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-gray-600 hover:text-gray-900">
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-gray-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-gray-500">&copy; {year} {SITE.name}. All rights reserved.</p>
      <ul class="flex gap-4">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-xs text-gray-500 underline hover:text-gray-900">
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

---
import { SITE } from '~/config';

// Placeholder logo: a simple mark + the site name. Replace the SVG with your
// real logo (or an <Image /> of it) per project.
---

<span class="flex items-center gap-2 font-semibold tracking-tight text-gray-900">
  <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="2" y="2" width="20" height="20" rx="5" class="fill-gray-900"></rect>
    <path d="M7 14.5 12 7l5 7.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="text-lg">{SITE.name}</span>
</span>

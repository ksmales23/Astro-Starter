---
import { ANALYTICS } from '~/config';
// Production: render only when consent is required AND GTM is configured —
// no tags means no non-essential cookies, so a banner would be noise.
// Dev: also render without a GTM ID (preview mode) so the banner can be
// styled and tested before analytics is wired up. Never applies to builds.
const hasGtm = Boolean(ANALYTICS.gtmId);
const devPreview = import.meta.env.DEV && !hasGtm;
const show = ANALYTICS.consentRequired && (hasGtm || devPreview);
---

{show && (
  <div
    x-data="consentBanner()"
    x-show="visible"
    x-cloak
    x-transition.opacity.duration.300ms
    class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-md rounded-xl border border-gray-200 bg-white p-5 shadow-2xl sm:inset-x-auto sm:left-4"
    role="dialog"
    aria-modal="false"
    aria-live="polite"
    aria-label="Cookie consent"
  >
    <h2 class="text-sm font-semibold text-gray-900">Cookies on this site</h2>
    <p class="mt-1 text-sm text-gray-600">
      We use cookies for analytics and advertising. Choose what you're happy with —
      nothing non-essential is set until you do.
      <a href="/privacy" class="underline">Privacy &amp; cookies</a>
    </p>

    <!-- Granular layer: per-purpose toggles (hidden until "Manage options"). -->
    <div x-show="managing" x-cloak x-transition class="mt-3 space-y-2 rounded-lg bg-gray-50 p-3">
      <label class="flex items-start gap-3">
        <input type="checkbox" x-model="prefs.analytics" class="mt-0.5 h-4 w-4 rounded border-gray-300" />
        <span class="text-sm">
          <span class="font-medium text-gray-900">Analytics</span>
          <span class="block text-gray-600">Helps us understand how the site is used.</span>
        </span>
      </label>
      <label class="flex items-start gap-3">
        <input type="checkbox" x-model="prefs.advertising" class="mt-0.5 h-4 w-4 rounded border-gray-300" />
        <span class="text-sm">
          <span class="font-medium text-gray-900">Advertising</span>
          <span class="block text-gray-600">Used to measure and personalise ads.</span>
        </span>
      </label>
      <button
        type="button"
        @click="saveChoices()"
        class="mt-1 w-full rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100"
      >
        Save choices
      </button>
    </div>

    <!-- Equal-prominence accept/reject (ICO requirement), manage as text link. -->
    <div class="mt-4 grid grid-cols-2 gap-2">
      <button
        type="button"
        @click="rejectAll()"
        class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100"
      >
        Reject all
      </button>
      <button
        type="button"
        @click="acceptAll()"
        class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700"
      >
        Accept all
      </button>
    </div>
    <button
      type="button"
      @click="managing = !managing"
      class="mt-2 w-full text-center text-xs text-gray-500 underline hover:text-gray-900"
      x-text="managing ? 'Hide options' : 'Manage options'"
    ></button>
  </div>
)}

{show && (
  <script is:inline define:vars={{ devPreview }}>
    window.consentBanner = function consentBanner() {
      return {
        devPreview: devPreview,
        visible: false,
        managing: false,
        // No pre-ticked boxes: granular toggles start unchecked (ICO).
        prefs: { analytics: false, advertising: false },
        init() {
          try { this.visible = !localStorage.getItem('consent-mode'); }
          catch (e) { this.visible = true; }
          if (this.devPreview && this.visible) {
            console.info(
              '[consent] Dev preview: banner shown without a GTM ID. Choices are stored ' +
              'in localStorage("consent-mode") but no tags load. Reset via /privacy.'
            );
          }
        },
        _apply(analytics, advertising) {
          var state = {
            analytics_storage: analytics ? 'granted' : 'denied',
            ad_storage: advertising ? 'granted' : 'denied',
            ad_user_data: advertising ? 'granted' : 'denied',
            ad_personalization: advertising ? 'granted' : 'denied',
          };
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('consent', 'update', state);
          try { localStorage.setItem('consent-mode', JSON.stringify(state)); } catch (e) {}
          this.visible = false;
        },
        acceptAll() { this._apply(true, true); },
        rejectAll() { this._apply(false, false); },
        saveChoices() { this._apply(this.prefs.analytics, this.prefs.advertising); },
      };
    };
  </script>
)}
